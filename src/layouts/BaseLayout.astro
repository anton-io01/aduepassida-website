---
import '../styles/style.css';
import '../styles/responsive.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { homePaths, t } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
  title: string;
  description: string;
  privacy?: boolean;
  ogImage?: string;
}

const { lang, title, description, privacy = false, ogImage } = Astro.props;
const siteUrl = import.meta.env.SITE || 'https://aduepassidabnb.it';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    {!privacy && <link rel="preload" as="image" href="/images/hero/hero-bg.jpg" fetchpriority="high">}
    <SEOHead
      lang={lang}
      title={title}
      description={description}
      privacy={privacy}
      ogImage={ogImage}
      siteUrl={siteUrl}
    />
</head>
<body>
    {privacy ? (
        <header id="site-header">
            <div class="container header-inner">
                <a href={`${homePaths[lang]}#hero`} class="logo">A Due Passi Da</a>
                <nav><a href={homePaths[lang]} class="btn btn-outline">{t(lang, 'privacy.back')}</a></nav>
            </div>
        </header>
    ) : <Header lang={lang} />}
    <main class:list={{ 'privacy-page': privacy }}>
        <slot />
    </main>
    <Footer lang={lang} privacy={privacy} />
    {!privacy && (
        <>
            <CookieBanner lang={lang} />
            <script src="/scripts/main.js" defer></script>
            <script src="/scripts/form.js" defer></script>
            <script src="/scripts/cookie-banner.js" defer></script>
        </>
    )}
</body>
</html>
