---
import { platformRatings, property } from '../data/property';
import { t } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;

interface ReviewItem {
  text: string;
  author: string;
  from: string;
  date: string;
  rating: number;
}

const items = t(lang, 'reviews.items') as ReviewItem[];
const platforms = [
  { name: 'Google', ...platformRatings.google, url: property.mapsUrl },
  { name: 'Booking.com', ...platformRatings.booking, url: `${property.bookingUrl[lang]}#tab-reviews` },
];
const scoreFormat = new Intl.NumberFormat(lang, { minimumFractionDigits: 1 });
const verifiedDate = new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-GB', {
  dateStyle: 'medium', timeZone: 'UTC',
}).format(new Date(platformRatings.verifiedOn));
---

<section id="recensioni" class="section">
    <div class="container">
        <h2 class="section-title">{t(lang, 'reviews.title')}</h2>
        <p class="section-subtitle">{t(lang, 'reviews.subtitle')}</p>

        <div class="platform-ratings">
            {platforms.map(({ name, score, scale, count, url }) => (
                <article class="review-card">
                    <h3>{name}</h3>
                    <p><strong>{scoreFormat.format(score)}/{scale}</strong> · {count} {t(lang, 'reviews.platform.count')}</p>
                    <p>{t(lang, 'reviews.platform.verified')} <time datetime={platformRatings.verifiedOn}>{verifiedDate}</time></p>
                    <a href={url} target="_blank" rel="noopener">{t(lang, 'reviews.platform.link')} {name}</a>
                </article>
            ))}
        </div>

        <div class="reviews-grid">
            {items.map((review) => {
                const fullStars = Math.floor(review.rating);
                const hasHalf = review.rating % 1 !== 0;
                return (
                    <article class="review-card">
                        <div class="review-header">
                            <div class="review-stars" role="img" aria-label={`${new Intl.NumberFormat(lang).format(review.rating)} ${lang === 'it' ? 'su' : 'out of'} 5`}>
                                {Array.from({ length: fullStars }).map(() => (
                                    <i aria-hidden="true" class="fa-solid fa-star"></i>
                                ))}
                                {hasHalf && <i aria-hidden="true" class="fa-solid fa-star-half-stroke"></i>}
                            </div>
                            <span class="review-date">{review.date}</span>
                        </div>
                        <blockquote class="review-text">
                            "{review.text}"
                        </blockquote>
                        <div class="review-author">
                            <strong>{review.author}</strong>
                            <span>{review.from}</span>
                        </div>
                    </article>
                );
            })}
        </div>
    </div>
</section>

<style>
    .platform-ratings {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-lg);
    }

    .platform-ratings article {
        padding: var(--spacing-md) var(--spacing-lg);
    }

    .platform-ratings h3 {
        font-size: 1.1rem;
        margin-bottom: var(--spacing-xs);
    }

    .platform-ratings p {
        margin-bottom: var(--spacing-xs);
    }

    .platform-ratings strong {
        font-size: 1.2em;
    }

    .platform-ratings a {
        text-decoration: underline;
    }
</style>
