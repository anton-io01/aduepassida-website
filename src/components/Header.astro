---
import { t, getAlternateUrl } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
const altLang = lang === 'it' ? 'en' : 'it';
const altUrl = lang === 'it' ? '/en/' : '/';
const homeUrl = lang === 'it' ? '/' : '/en/';
---

<header id="site-header">
    <div class="container header-inner">
        <a href={`${homeUrl}#hero`} class="logo">A Due Passi Da</a>
        <nav id="main-nav">
            <ul class="nav-links">
                <li><a href={`${homeUrl}#struttura`}>{t(lang, 'nav.struttura')}</a></li>
                <li><a href={`${homeUrl}#galleria`}>{t(lang, 'nav.galleria')}</a></li>
                <li><a href={`${homeUrl}#servizi`}>{t(lang, 'nav.servizi')}</a></li>
                <li><a href={`${homeUrl}#posizione`}>{t(lang, 'nav.posizione')}</a></li>
                <li><a href={`${homeUrl}#attrazioni`}>{t(lang, 'nav.attrazioni')}</a></li>
                <li><a href={`${homeUrl}#recensioni`}>{t(lang, 'nav.recensioni')}</a></li>
                <li><a href={`${homeUrl}#preventivo`} class="btn btn-primary">{t(lang, 'nav.preventivo')}</a></li>
            </ul>
            <div class="lang-toggle">
                <a href="/" class={lang === 'it' ? 'active' : ''} aria-label={t(lang, 'nav.langItLabel')}>IT</a>
                <span>|</span>
                <a href="/en/" class={lang === 'en' ? 'active' : ''} aria-label={t(lang, 'nav.langEnLabel')}>EN</a>
            </div>
            <button class="hamburger" id="hamburger-btn" aria-label={t(lang, 'nav.hamburgerLabel')} aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </nav>
    </div>
</header>
