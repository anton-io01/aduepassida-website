---
import { t, homePaths } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
---

<header id="site-header">
    <div class="container header-inner">
        <a href="#hero" class="logo">A Due Passi Da</a>
        <nav id="main-nav">
            <button class="hamburger" type="button" id="hamburger-btn" aria-label={t(lang, 'nav.hamburgerLabel')} aria-expanded="false" aria-controls="nav-links">
                <span></span><span></span><span></span>
            </button>
            <ul class="nav-links" id="nav-links">
                <li><a href="#struttura">{t(lang, 'nav.struttura')}</a></li>
                <li><a href="#galleria">{t(lang, 'nav.galleria')}</a></li>
                <li><a href="#servizi">{t(lang, 'nav.servizi')}</a></li>
                <li><a href="#posizione">{t(lang, 'nav.posizione')}</a></li>
                <li><a href="#attrazioni">{t(lang, 'nav.attrazioni')}</a></li>
                <li><a href="#recensioni">{t(lang, 'nav.recensioni')}</a></li>
                <li><a href="#preventivo" class="btn btn-primary">{t(lang, 'nav.preventivo')}</a></li>
            </ul>
            <div class="lang-toggle">
                <a href={homePaths.it} class={lang === 'it' ? 'active' : ''} aria-label={t(lang, 'nav.langItLabel')} aria-current={lang === 'it' ? 'page' : undefined}>IT</a>
                <span>|</span>
                <a href={homePaths.en} class={lang === 'en' ? 'active' : ''} aria-label={t(lang, 'nav.langEnLabel')} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
            </div>
        </nav>
    </div>
</header>
