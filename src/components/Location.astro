---
import { property } from '../data/property';
import { t } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
const { streetAddress, postalCode, addressLocality, addressRegion } = property.address;
const mapEmbed = `https://maps.google.com/maps?q=${property.latitude},${property.longitude}&hl=${lang}&z=17&output=embed`;
---

<section id="posizione" class="section">
    <div class="container">
        <h2 class="section-title">{t(lang, 'location.title')}</h2>
        <p class="section-subtitle">{t(lang, 'location.subtitle')}</p>

        <div class="location-grid">
            <div class="location-info">
                <div class="location-address">
                    <i aria-hidden="true" class="fa-solid fa-location-dot"></i>
                    <div>
                        <strong>{t(lang, 'location.addressName')}</strong>
                        <p>{streetAddress}<br>{postalCode} {addressLocality} {addressRegion}</p>
                    </div>
                </div>

                <div class="location-directions">
                    <h3><i aria-hidden="true" class="fa-solid fa-train"></i> {t(lang, 'location.directions.trainTitle')}</h3>
                    <p>{t(lang, 'location.directions.trainDesc')}</p>

                    <h3><i aria-hidden="true" class="fa-solid fa-plane"></i> {t(lang, 'location.directions.airportTitle')}</h3>
                    <p>{t(lang, 'location.directions.airportDesc')}</p>
                </div>
            </div>

            <div class="location-map">
                <iframe
                    src={mapEmbed}
                    width="100%"
                    height="400"
                    style="border:0; border-radius: 16px;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title={t(lang, 'location.mapTitle')}>
                </iframe>
                <p class="map-fallback">
                    <a href={property.mapsUrl} target="_blank" rel="noopener">
                        <i aria-hidden="true" class="fa-solid fa-external-link"></i> {t(lang, 'location.mapFallback')}
                    </a>
                </p>
            </div>
        </div>
    </div>
</section>
