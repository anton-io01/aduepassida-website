---
import { t } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
const privacyUrl = lang === 'it' ? '/privacy-policy/' : '/en/privacy-policy/';
---

<div id="cookie-banner" class="cookie-banner" hidden>
    <div class="cookie-content">
        <p><i class="fa-solid fa-cookie-bite"></i> <strong>{t(lang, 'cookie.title')}</strong> {t(lang, 'cookie.description')} <a href={privacyUrl}>{t(lang, 'cookie.privacyLink')}</a></p>
        <button id="cookie-accept" class="btn btn-primary">{t(lang, 'cookie.acceptSelected')}</button>
    </div>
</div>
