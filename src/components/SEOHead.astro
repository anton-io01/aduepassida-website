---
import { property } from '../data/property';
import { homePaths, privacyPaths, t } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
  title: string;
  description: string;
  privacy?: boolean;
  ogImage?: string;
  siteUrl: string;
}

const { lang, title, description, privacy, ogImage, siteUrl } = Astro.props;

const baseUrl = siteUrl.replace(/\/$/, '');
const paths = privacy ? privacyPaths : homePaths;
const currentCanonical = new URL(paths[lang], baseUrl);
const alternateIt = new URL(paths.it, baseUrl);
const alternateEn = new URL(paths.en, baseUrl);
const ogLocale = lang === 'it' ? 'it_IT' : 'en_US';
const ogImg = ogImage || `${baseUrl}/images/hero/hero-bg.jpg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BedAndBreakfast",
  "name": "A Due Passi Da",
  "description": description,
  "image": ogImg,
  "address": {
    "@type": "PostalAddress",
    ...property.address
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": property.latitude,
    "longitude": property.longitude
  },
  "telephone": property.phone,
  "email": "aduepassida.beb@gmail.com",
  "url": currentCanonical.href,
  "priceRange": "€€",
  "amenityFeature": [
    {"@type": "LocationFeatureSpecification", "name": lang === 'it' ? "Wi-Fi gratuito" : "Free Wi-Fi", "value": true},
    {"@type": "LocationFeatureSpecification", "name": t(lang, 'services.labels.breakfast'), "value": true},
    {"@type": "LocationFeatureSpecification", "name": lang === 'it' ? "Aria condizionata" : "Air conditioning", "value": true},
    {"@type": "LocationFeatureSpecification", "name": lang === 'it' ? "Terrazza" : "Terrace", "value": true},
    {"@type": "LocationFeatureSpecification", "name": lang === 'it' ? "Cucina attrezzata" : "Equipped kitchen", "value": true}
  ],
  "checkoutTime": "11:00",
  "numberOfRooms": 2,
  "petsAllowed": lang === 'it' ? "Contattare la struttura" : "Contact the property"
};
---

<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="A Due Passi Da">
<link rel="canonical" href={currentCanonical}>

<!-- Hreflang -->
<link rel="alternate" hreflang="it" href={alternateIt}>
<link rel="alternate" hreflang="en" href={alternateEn}>
<link rel="alternate" hreflang="x-default" href={alternateIt}>

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:url" content={currentCanonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImg}>
<meta property="og:locale" content={ogLocale}>

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImg}>

<!-- JSON-LD -->
{!privacy && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
