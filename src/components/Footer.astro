---
import { t, privacyPaths } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
  privacy?: boolean;
}

const { lang, privacy = false } = Astro.props;
const waMessage = encodeURIComponent(t(lang, 'contacts.whatsapp.message'));
---

<footer id="site-footer">
    <div class="container footer-inner">
        <div class="footer-brand">
            <span class="footer-name">{t(lang, 'footer.brand')}</span>
            <p>{t(lang, 'footer.address')}</p>
        </div>
        {!privacy && (
            <>
                <div class="footer-contacts">
                    <a href="mailto:aduepassida.beb@gmail.com"><i aria-hidden="true" class="fa-solid fa-envelope"></i> aduepassida.beb@gmail.com</a>
                    <a href="tel:+393387066312"><i aria-hidden="true" class="fa-solid fa-phone"></i> +39 3387066312</a>
                    <a href={`https://wa.me/393387066312?text=${waMessage}`} target="_blank" rel="noopener noreferrer"><i aria-hidden="true" class="fa-brands fa-whatsapp"></i> +39 3387066312</a>
                </div>
                <nav class="footer-nav">
                    <a href="#struttura">{t(lang, 'footer.nav.struttura')}</a>
                    <a href="#servizi">{t(lang, 'footer.nav.servizi')}</a>
                    <a href="#preventivo">{t(lang, 'footer.nav.preventivo')}</a>
                    <a href="#contatti">{t(lang, 'footer.nav.contatti')}</a>
                    <a href={privacyPaths[lang]}>{t(lang, 'footer.nav.privacy')}</a>
                </nav>
            </>
        )}
        <p class="footer-copy" style={privacy ? 'grid-column: 1 / -1; margin-top: 20px;' : undefined}>
            {privacy && '© '}{t(lang, 'footer.copyright')}
        </p>
    </div>
</footer>
