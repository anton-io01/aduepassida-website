---
import { t } from '../i18n/utils';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
const badges = t(lang, 'hero.badges') as Array<{icon: string; text: string}>;
---

<section id="hero">
    <div class="hero-overlay">
        <div class="hero-content">
            <p class="hero-pre-title">{t(lang, 'hero.preTitle')}</p>
            <h1 class="hero-title">{t(lang, 'hero.title')}</h1>
            <p class="hero-tagline">{t(lang, 'hero.tagline')}</p>
            <div class="hero-badges">
                {badges.map((badge) => (
                    <div class="badge">
                        <i class={`fa-solid ${badge.icon}`}></i>
                        <span>{badge.text}</span>
                    </div>
                ))}
            </div>
            <div class="hero-cta">
                <a href="#preventivo" class="btn btn-primary btn-large">
                    {t(lang, 'hero.cta')}
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
                <a href="#struttura" class="btn btn-secondary btn-large">
                    {t(lang, 'hero.ctaSecondary')}
                </a>
            </div>
        </div>
    </div>
</section>
